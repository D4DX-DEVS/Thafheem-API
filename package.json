    "firebase-admin": "^14.1.0",
    "helmet": "^8.2.0",
    "marked": "4.3.0",
    "mysql2": "^3.23.1",
    "nodemailer": "^7.0.13",
    "redis": "^5.10.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1"
